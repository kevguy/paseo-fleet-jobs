{
  "name": "paseo-fleet-jobs",
  "private": false,
  "version": "0.2.0",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "bin/",
    "README.md",
    "LICENSE",
    "examples/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:cli": "esbuild scripts/cli.ts --bundle --platform=node --target=node20 --format=esm --outfile=bin/fleet-jobs.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepack": "npm run typecheck && npm run build:cli"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.16.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^26.6.6",
    "@types/react": "~19.2.0",
    "esbuild": "^0.28.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "description": "Read-only job progress and verified result evidence across your Paseo hosts.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fleet-jobs": "bin/fleet-jobs.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
